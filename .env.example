# Fahrtwerk – Produktive Standardkonfiguration ohne vorbelegte Geheimnisse.
# Kopieren: cp .env.example .env ; Start: docker compose up -d --build
# Niemals die ausgefüllte .env ins Versionskontrollsystem aufnehmen.
APP_NAME="Fahrtwerk – Digitale Fahrtenverwaltung"
APP_ENV=production
APP_DEBUG=false
# Interne Adresse anpassen; für den produktiven Betrieb HTTPS vorgeschalten.
APP_URL=http://localhost:8080
APP_PORT=8080
# Standardmäßig nur lokal erreichbar. Für das interne LAN z.B. 0.0.0.0 setzen.
APP_BIND=127.0.0.1
APP_TIMEZONE=Europe/Berlin
# Laravel verwendet de; die Anwendung entspricht de-DE.
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
# Leer lassen: beim ersten Containerstart sicher generiert und im Storage-Volume bewahrt.
APP_KEY=

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=fahrtwerk
DB_USERNAME=fahrtwerk
# Leer lassen: einmalige sichere Erzeugung im secrets-Volume.
# Ein bereits initialisierter PostgreSQL-Cluster übernimmt Passwortänderungen hier NICHT automatisch.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Bei APP_URL=https://... unbedingt true. Der lokale HTTP-Erststart benötigt false.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
HASH_DRIVER=argon2id

# Selbstregistrierung wird unabhängig von diesem Wert nicht angeboten.
ALLOW_SELF_REGISTRATION=false
# Unterstützter Modus: random. Bewusst keine unsicheren Standardpasswörter.
INITIAL_PASSWORD_MODE=random
ENFORCE_ODOMETER_CONTINUITY=false
ALLOW_PRIVATE_KM=true
ALLOW_COMMUTE_KM=true
# Nichtkritische Änderungen optional; abrechnungsrelevante Aktionen immer protokolliert.
AUDIT_LOG_ENABLED=true
ORGANIZATION_NAME="Kommunale Verwaltung"

BOOTSTRAP_ADMIN_USERNAME=admin
# Leer: zufälliges Einmalpasswort in storage/app/private/bootstrap-admin.txt.
# Alternativ hier ein eigenes initiales Passwort setzen (mindestens 8 Zeichen).
# Bereits bestehende Konten werden beim Neustart niemals zurückgesetzt.
BOOTSTRAP_ADMIN_PASSWORD=

# Keine automatischen Demo-Accounts im Produktivbetrieb.
DEMO_ENABLED=false
LOG_CHANNEL=stderr
LOG_LEVEL=warning

